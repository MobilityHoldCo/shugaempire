# Hostinger / LiteSpeed configuration for Next.js Static Export & API
DirectoryIndex index.html index.php

RewriteEngine On

# 1. Force HTTPS and normalize www to non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://shugaempire.com/$1 [L,R=301]

# 2. Protect CSV and sensitive files from direct browser download
<FilesMatch "\.(csv|log|env|git)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3. Route /api endpoints to php scripts
RewriteRule ^api/waitlist/?$ api/waitlist.php [L]
RewriteRule ^api/contact/?$ api/contact.php [L]
RewriteRule ^api/admin_waitlist/?$ api/admin_waitlist.php [L]

# 4. If requested file exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. If requested directory contains index.html, serve it directly
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# 6. Clean URLs: Map /page to /page.html if it exists
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 7. Fallback for nested clean URLs: Map /folder/page to /folder/page.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 8. Custom 404 Error Document
ErrorDocument 404 /404.html

# 9. Ensure Proper MIME Types
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType video/webm .webm
</IfModule>

# 10. Prevent HTML Caching (Stops FOUC & Old Chunk Mismatch)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# 11. Cache Static Assets for fast loading
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

